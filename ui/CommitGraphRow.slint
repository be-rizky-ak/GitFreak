export component CommitGraphRow inherits Rectangle {
    in property <int> lane: 0;
    in property <bool> is-active: true;
    in property <bool> has-upper-line: true;
    in property <bool> is-upper-line-active: root.is-active;

    in property <[int]> parent-lanes: [];
    in property <[bool]> parent-lanes-active: [];

    in property <[int]> active-lanes: [];
    in property <[bool]> active-lanes-active: [];

    in property <int> max-lane: 0;

    in property <int> lane-spacing: 16;
    in property <int> graph-left: 18;

    height: 42px;
    width: Math.max(120px, (root.graph-left + (root.max-lane + 1) * root.lane-spacing + 16) * 1px);
    background: transparent;

    pure function get-lane-color(lane-idx: int, active: bool) -> color {
        if (!active) {
            return #94a3b8; // Gray for inactive/unmerged branch lines
        }
        if (lane-idx == 0) { return #2563eb; } // Blue
        if (lane-idx == 1) { return #16a34a; } // Green
        if (lane-idx == 2) { return #d97706; } // Amber
        if (lane-idx == 3) { return #9333ea; } // Purple
        if (lane-idx == 4) { return #e11d48; } // Rose
        if (lane-idx == 5) { return #0891b2; } // Cyan
        if (lane-idx == 6) { return #4f46e5; } // Indigo
        if (lane-idx == 7) { return #c026d3; } // Fuchsia
        if (lane-idx == 8) { return #059669; } // Emerald
        if (lane-idx == 9) { return #ea580c; } // Orange
        return #64748b;                        // Slate default
    }

    pure function get-line-width(active: bool) -> length {
        if (active) {
            return 3px;
        }
        return 2px;
    }

    pure function get-line-x-offset(active: bool) -> length {
        if (active) {
            return 1.5px;
        }
        return 1px;
    }

    // =================================================
    // POSITIONS
    // =================================================

    property <length> current-x:
        root.graph-left * 1px
        + root.lane * root.lane-spacing * 1px;

    // =================================================
    // PASS 1: INACTIVE LINES (Background layer)
    // =================================================

    // 1. Current Lane Incoming (Top to Node) - Inactive
    Rectangle {
        visible: root.lane >= 0 && root.has-upper-line && !root.is-upper-line-active;

        width: root.get-line-width(false);
        x: root.current-x - root.get-line-x-offset(false);
        y: 0px;
        height: root.height / 2 + 1px;

        background: root.get-lane-color(root.lane, false);
    }

    // 2. Active Branch Lanes - Inactive
    for active-lane[i] in root.active-lanes: Rectangle {
        visible: active-lane != root.lane && !root.active-lanes-active[i];

        width: root.get-line-width(false);
        x: (root.graph-left + active-lane * root.lane-spacing) * 1px - root.get-line-x-offset(false);
        y: 0px;
        height: root.height;

        background: root.get-lane-color(active-lane, false);
    }

    // 3. Parent Connections - Case 1: Straight down - Inactive
    for p-lane[i] in root.parent-lanes: Rectangle {
        visible: p-lane == root.lane && !root.parent-lanes-active[i];

        width: root.get-line-width(false);
        x: root.current-x - root.get-line-x-offset(false);
        y: root.height / 2 - 1px;
        height: root.height / 2 + 2px;

        background: root.get-lane-color(root.lane, false);
    }

    // 4. Parent Connections - Case 2: Stem down - Inactive
    for p-lane[i] in root.parent-lanes: Rectangle {
        visible: p-lane != root.lane && !root.parent-lanes-active[i];

        width: root.get-line-width(false);
        x: root.current-x - root.get-line-x-offset(false);
        y: root.height / 2 - 1px;
        height: root.height / 4 + 2px;

        background: root.get-lane-color(root.lane, false);
    }

    // 5. Parent Connections - Case 2: Horizontal bridge - Inactive
    for p-lane[i] in root.parent-lanes: Rectangle {
        property <length> parent-x: (root.graph-left + p-lane * root.lane-spacing) * 1px;
        property <length> line-w: root.get-line-width(false);
        property <length> line-off: root.get-line-x-offset(false);

        visible: p-lane != root.lane && !root.parent-lanes-active[i];

        width: parent-x > root.current-x
            ? parent-x - root.current-x + line-w
            : root.current-x - parent-x + line-w;

        height: line-w;

        x: parent-x < root.current-x
            ? parent-x - line-off
            : root.current-x - line-off;

        y: root.height * 3 / 4 - line-off;

        background: root.get-lane-color(p-lane, false);
    }

    // 6. Parent Connections - Case 2: Vertical segment down in parent lane - Inactive
    for p-lane[i] in root.parent-lanes: Rectangle {
        property <length> parent-x: (root.graph-left + p-lane * root.lane-spacing) * 1px;
        property <length> line-w: root.get-line-width(false);
        property <length> line-off: root.get-line-x-offset(false);

        visible: p-lane != root.lane && !root.parent-lanes-active[i];

        width: line-w;
        x: parent-x - line-off;
        y: root.height * 3 / 4 - line-off;
        height: root.height / 4 + line-off + 1px;

        background: root.get-lane-color(p-lane, false);
    }

    // =================================================
    // PASS 2: ACTIVE LINES (Foreground / Foreground layer)
    // =================================================

    // 1. Current Lane Incoming (Top to Node) - Active
    Rectangle {
        visible: root.lane >= 0 && root.has-upper-line && root.is-upper-line-active;

        width: root.get-line-width(true);
        x: root.current-x - root.get-line-x-offset(true);
        y: 0px;
        height: root.height / 2 + 1px;

        background: root.get-lane-color(root.lane, true);
    }

    // 2. Active Branch Lanes - Active
    for active-lane[i] in root.active-lanes: Rectangle {
        visible: active-lane != root.lane && root.active-lanes-active[i];

        width: root.get-line-width(true);
        x: (root.graph-left + active-lane * root.lane-spacing) * 1px - root.get-line-x-offset(true);
        y: 0px;
        height: root.height;

        background: root.get-lane-color(active-lane, true);
    }

    // 3. Parent Connections - Case 1: Straight down - Active
    for p-lane[i] in root.parent-lanes: Rectangle {
        visible: p-lane == root.lane && root.parent-lanes-active[i];

        width: root.get-line-width(true);
        x: root.current-x - root.get-line-x-offset(true);
        y: root.height / 2 - 1px;
        height: root.height / 2 + 2px;

        background: root.get-lane-color(root.lane, true);
    }

    // 4. Parent Connections - Case 2: Stem down - Active
    for p-lane[i] in root.parent-lanes: Rectangle {
        visible: p-lane != root.lane && root.parent-lanes-active[i];

        width: root.get-line-width(true);
        x: root.current-x - root.get-line-x-offset(true);
        y: root.height / 2 - 1px;
        height: root.height / 4 + 2px;

        background: root.get-lane-color(root.lane, true);
    }

    // 5. Parent Connections - Case 2: Horizontal bridge - Active
    for p-lane[i] in root.parent-lanes: Rectangle {
        property <length> parent-x: (root.graph-left + p-lane * root.lane-spacing) * 1px;
        property <length> line-w: root.get-line-width(true);
        property <length> line-off: root.get-line-x-offset(true);

        visible: p-lane != root.lane && root.parent-lanes-active[i];

        width: parent-x > root.current-x
            ? parent-x - root.current-x + line-w
            : root.current-x - parent-x + line-w;

        height: line-w;

        x: parent-x < root.current-x
            ? parent-x - line-off
            : root.current-x - line-off;

        y: root.height * 3 / 4 - line-off;

        background: root.get-lane-color(p-lane, true);
    }

    // 6. Parent Connections - Case 2: Vertical segment down in parent lane - Active
    for p-lane[i] in root.parent-lanes: Rectangle {
        property <length> parent-x: (root.graph-left + p-lane * root.lane-spacing) * 1px;
        property <length> line-w: root.get-line-width(true);
        property <length> line-off: root.get-line-x-offset(true);

        visible: p-lane != root.lane && root.parent-lanes-active[i];

        width: line-w;
        x: parent-x - line-off;
        y: root.height * 3 / 4 - line-off;
        height: root.height / 4 + line-off + 1px;

        background: root.get-lane-color(p-lane, true);
    }

    // =================================================
    // PASS 3: COMMIT NODE (Drawn last on top)
    // =================================================

    Rectangle {
        visible: root.lane >= 0;

        width: 10px;
        height: 10px;
        x: root.current-x - 5px;
        y: (root.height - self.height) / 2;
        border-radius: 5px;

        background: root.get-lane-color(root.lane, root.is-active);
        border-width: 2px;
        border-color: #ffffff;
    }
}
