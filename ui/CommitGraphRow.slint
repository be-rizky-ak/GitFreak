export component CommitGraphRow inherits Rectangle {
    in property <int> lane: 0;

    in property <int> parent-lane-0: 0;
    in property <int> parent-lane-1: 0;

    in property <int> parent-count: 0;

    in property <int> active-lane-0: 0;
    in property <int> active-lane-1: 0;
    in property <int> active-lane-count: 0;

    in property <int> lane-spacing: 16;
    in property <int> graph-left: 18;

    height: 42px;
    background: transparent;

    pure function get-lane-color(lane-idx: int) -> color {
        if (lane-idx == 0) { return #2563eb; } // Blue
        if (lane-idx == 1) { return #16a34a; } // Green
        if (lane-idx == 2) { return #d97706; } // Amber
        if (lane-idx == 3) { return #9333ea; } // Purple
        return #64748b;                       // Slate default
    }

    // =================================================
    // POSITIONS
    // =================================================

    property <length> current-x:
        root.graph-left * 1px
        + root.lane * root.lane-spacing * 1px;

    property <length> parent-x-0:
        root.graph-left * 1px
        + root.parent-lane-0 * root.lane-spacing * 1px;

    property <length> parent-x-1:
        root.graph-left * 1px
        + root.parent-lane-1 * root.lane-spacing * 1px;

    property <length> active-x-0:
        root.graph-left * 1px
        + root.active-lane-0 * root.lane-spacing * 1px;

    property <length> active-x-1:
        root.graph-left * 1px
        + root.active-lane-1 * root.lane-spacing * 1px;

    // =================================================
    // CURRENT LANE - INCOMING
    // =================================================

    Rectangle {
        visible: root.lane >= 0;

        width: 2px;
        x: root.current-x - 1px;
        y: 0px;
        height: root.height / 2;

        background: root.get-lane-color(root.lane);
    }

    // =================================================
    // ACTIVE BRANCH LANES
    // =================================================

    // First active lane
    Rectangle {
        visible: root.active-lane-count > 0 &&
            root.active-lane-0 != root.lane &&
            !(
            root.parent-count > 1 &&
            root.active-lane-0 == root.parent-lane-1);

        width: 2px;
        x: root.active-x-0 - 1px;
        y: 0px;
        height: root.height;

        background: root.get-lane-color(root.active-lane-0);
    }

    Rectangle {
        visible: root.active-lane-count > 0 &&
            root.active-lane-0 != root.lane &&
            root.parent-count > 1 &&
            root.active-lane-0 == root.parent-lane-1;

        width: 2px;
        x: root.active-x-0 - 1px;
        y: root.height * 3 / 4;
        height: root.height / 4 + 1px;

        background: root.get-lane-color(root.active-lane-0);
    }

    // Second active lane
    Rectangle {
        visible: root.active-lane-count > 1 &&
            root.active-lane-1 != root.lane &&
            root.active-lane-1 != root.active-lane-0 &&
            !(
            root.parent-count > 1 &&
            root.active-lane-1 == root.parent-lane-1);

        width: 2px;
        x: root.active-x-1 - 1px;
        y: 0px;
        height: root.height;

        background: root.get-lane-color(root.active-lane-1);
    }

    Rectangle {
        visible: root.active-lane-count > 1 &&
            root.active-lane-1 != root.lane &&
            root.active-lane-1 != root.active-lane-0 &&
            root.parent-count > 1 &&
            root.active-lane-1 == root.parent-lane-1;

        width: 2px;
        x: root.active-x-1 - 1px;
        y: root.height * 3 / 4;
        height: root.height / 4 + 1px;

        background: root.get-lane-color(root.active-lane-1);
    }

    // =================================================
    // FIRST PARENT
    // =================================================

    Rectangle {
        visible: root.parent-count > 0 &&
            root.lane == root.parent-lane-0;

        width: 2px;
        x: root.current-x - 1px;
        y: root.height / 2;
        height: root.height / 2 + 1px;

        background: root.get-lane-color(root.lane);
    }

    Rectangle {
        visible: root.parent-count > 0 &&
            root.lane != root.parent-lane-0;

        width: 2px;
        x: root.current-x - 1px;
        y: root.height / 2;
        height: root.height / 4;

        background: root.get-lane-color(root.lane);
    }

    Rectangle {
        visible: root.parent-count > 0 &&
            root.lane != root.parent-lane-0;

        width: root.parent-x-0 > root.current-x
            ? root.parent-x-0 - root.current-x + 2px
            : root.current-x - root.parent-x-0 + 2px;

        height: 2px;

        x: root.parent-x-0 < root.current-x
            ? root.parent-x-0 - 1px
            : root.current-x - 1px;

        y: root.height * 3 / 4;

        background: root.get-lane-color(root.parent-lane-0);
    }

    Rectangle {
        visible: root.parent-count > 0 &&
            root.lane != root.parent-lane-0;

        width: 2px;
        x: root.parent-x-0 - 1px;
        y: root.height * 3 / 4;
        height: root.height / 4 + 1px;

        background: root.get-lane-color(root.parent-lane-0);
    }

    // =================================================
    // SECOND PARENT / MERGE
    // =================================================

    Rectangle {
        visible: root.parent-count > 1 &&
            root.lane != root.parent-lane-1;

        width: 2px;
        x: root.current-x - 1px;
        y: root.height / 2;
        height: root.height / 4;

        background: root.get-lane-color(root.lane);
    }

    Rectangle {
        visible: root.parent-count > 1 &&
            root.lane != root.parent-lane-1;

        width: root.parent-x-1 > root.current-x
            ? root.parent-x-1 - root.current-x + 2px
            : root.current-x - root.parent-x-1 + 2px;

        height: 2px;

        x: root.parent-x-1 < root.current-x
            ? root.parent-x-1 - 1px
            : root.current-x - 1px;

        y: root.height * 3 / 4;

        background: root.get-lane-color(root.parent-lane-1);
    }

    // =================================================
    // COMMIT NODE
    // =================================================

    Rectangle {
        visible: root.lane >= 0;

        width: 10px;
        height: 10px;
        x: root.current-x - 5px;
        y: (root.height - self.height) / 2;
        border-radius: 5px;

        background: root.get-lane-color(root.lane);
        border-width: 2px;
        border-color: #ffffff;
    }
}
