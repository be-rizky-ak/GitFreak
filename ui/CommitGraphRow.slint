export component CommitGraphRow inherits Rectangle {
    in property <int> lane: 0;

    in property <[int]> parent-lanes: [];
    in property <[int]> active-lanes: [];

    in property <int> max-lane: 0;

    in property <int> lane-spacing: 16;
    in property <int> graph-left: 18;

    height: 42px;
    width: Math.max(120px, (root.graph-left + (root.max-lane + 1) * root.lane-spacing + 16) * 1px);
    background: transparent;

    pure function get-lane-color(lane-idx: int) -> color {
        if (lane-idx == 0) { return #2563eb; } // Blue
        if (lane-idx == 1) { return #16a34a; } // Green
        if (lane-idx == 2) { return #d97706; } // Amber
        if (lane-idx == 3) { return #9333ea; } // Purple
        if (lane-idx == 4) { return #e11d48; } // Rose
        if (lane-idx == 5) { return #0891b2; } // Cyan
        if (lane-idx == 6) { return #4f46e5; } // Indigo
        if (lane-idx == 7) { return #c026d3; } // Fuchsia
        if (lane-idx == 8) { return #059669; } // Emerald
        if (lane-idx == 9) { return #ea580c; } // Orange
        return #64748b;                        // Slate default
    }

    // =================================================
    // POSITIONS
    // =================================================

    property <length> current-x:
        root.graph-left * 1px
        + root.lane * root.lane-spacing * 1px;

    // =================================================
    // CURRENT LANE - INCOMING (Top to Node)
    // =================================================

    Rectangle {
        visible: root.lane >= 0;

        width: 2px;
        x: root.current-x - 1px;
        y: 0px;
        height: root.height / 2;

        background: root.get-lane-color(root.lane);
    }

    // =================================================
    // ACTIVE BRANCH LANES
    // =================================================

    for active-lane in root.active-lanes: Rectangle {
        visible: active-lane != root.lane;

        width: 2px;
        x: (root.graph-left + active-lane * root.lane-spacing) * 1px - 1px;
        y: 0px;
        height: root.height;

        background: root.get-lane-color(active-lane);
    }

    // =================================================
    // PARENT CONNECTIONS
    // =================================================

    // Case 1: First/main parent in same lane (straight down)
    for p-lane in root.parent-lanes: Rectangle {
        visible: p-lane == root.lane;

        width: 2px;
        x: root.current-x - 1px;
        y: root.height / 2;
        height: root.height / 2 + 1px;

        background: root.get-lane-color(root.lane);
    }

    // Case 2: Parent in different lane (vertical stem down)
    for p-lane in root.parent-lanes: Rectangle {
        visible: p-lane != root.lane;

        width: 2px;
        x: root.current-x - 1px;
        y: root.height / 2;
        height: root.height / 4;

        background: root.get-lane-color(root.lane);
    }

    // Case 2: Parent in different lane (horizontal bridge)
    for p-lane in root.parent-lanes: Rectangle {
        property <length> parent-x: (root.graph-left + p-lane * root.lane-spacing) * 1px;

        visible: p-lane != root.lane;

        width: parent-x > root.current-x
            ? parent-x - root.current-x + 2px
            : root.current-x - parent-x + 2px;

        height: 2px;

        x: parent-x < root.current-x
            ? parent-x - 1px
            : root.current-x - 1px;

        y: root.height * 3 / 4;

        background: root.get-lane-color(p-lane);
    }

    // Case 2: Parent in different lane (vertical segment down in parent lane)
    for p-lane in root.parent-lanes: Rectangle {
        property <length> parent-x: (root.graph-left + p-lane * root.lane-spacing) * 1px;

        visible: p-lane != root.lane;

        width: 2px;
        x: parent-x - 1px;
        y: root.height * 3 / 4;
        height: root.height / 4 + 1px;

        background: root.get-lane-color(p-lane);
    }

    // =================================================
    // COMMIT NODE
    // =================================================

    Rectangle {
        visible: root.lane >= 0;

        width: 10px;
        height: 10px;
        x: root.current-x - 5px;
        y: (root.height - self.height) / 2;
        border-radius: 5px;

        background: root.get-lane-color(root.lane);
        border-width: 2px;
        border-color: #ffffff;
    }
}
