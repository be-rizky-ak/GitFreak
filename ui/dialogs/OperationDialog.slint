import { Button, ListView } from "std-widgets.slint";

component OperationDialog inherits Rectangle {
    in property <bool> dialog-visible: false;
    in property <string> operation-title: "";
    in property <string> operation-command: "";
    in property <[string]> operation-log-lines: [];
    in property <string> operation-status: "Running...";
    in property <bool> operation-running: false;

    callback close-dialog();

    visible: root.dialog-visible;

    background: #00000060;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        width: 780px;
        height: 540px;

        background: #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: #cbd5e1;

        VerticalLayout {
            padding: 20px;
            spacing: 14px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                Text {
                    text: root.operation-title;
                    font-size: 20px;
                    font-weight: 700;
                    color: #1e293b;

                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 90px;
                    height: 28px;
                    border-radius: 6px;
                    background: root.operation-running ? #eff6ff : #f0fdf4;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: root.operation-running ? "Running" : root.operation-status;
                        font-size: 12px;
                        font-weight: 600;
                        color: root.operation-running ? #2563eb : #16a34a;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: "Command";
                font-size: 13px;
                font-weight: 600;
                color: #475569;
            }

            Rectangle {
                height: 40px;
                background: #f8fafc;
                border-radius: 6px;
                border-width: 1px;
                border-color: #e2e8f0;

                Text {
                    x: 12px;
                    y: 0px;
                    width: parent.width - 24px;
                    height: parent.height;

                    text: "$ " + root.operation-command;
                    font-family: "Consolas";
                    font-size: 13px;
                    color: #334155;

                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Text {
                text: "Output Log";
                font-size: 13px;
                font-weight: 600;
                color: #475569;
            }

            Rectangle {
                vertical-stretch: 1;
                background: #0f172a;
                border-radius: 6px;
                border-width: 1px;
                border-color: #1e293b;

                ListView {
                    width: parent.width;
                    height: parent.height;

                    for line in root.operation-log-lines: Rectangle {
                        height: 22px;
                        width: parent.width;
                        background: transparent;

                        Text {
                            x: 12px;
                            y: 0px;
                            width: parent.width - 24px;
                            height: parent.height;

                            text: line;
                            font-family: "Consolas";
                            font-size: 12px;
                            color: #e2e8f0;

                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                Text {
                    text: root.operation-status;
                    color: #64748b;
                    font-size: 13px;

                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                Button {
                    text: "Close";
                    enabled: !root.operation-running;

                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }
    }
}

export { OperationDialog }
