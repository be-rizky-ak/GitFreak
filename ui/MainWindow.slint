import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    ListView,
    ScrollView
} from "std-widgets.slint";
import { CloneDialog } from "dialogs/CloneDialog.slint";
import { OperationDialog } from "dialogs/OperationDialog.slint";
import { CommitGraphRow } from "CommitGraphRow.slint";

export component MainWindow inherits Window {
    title: "GitFreak";

    width: 1600px;
    height: 950px;
    background: #f0f3f8;

    in property <string> repository-path: "";
    in property <[string]> repository-names: [];
    in property <[string]> repository-paths: [];
    in property <string> status-text: "No repository opened.";
    in property <string> diff-text: "Select a file to view its diff.";
    in property <[string]> changed-files: [];
    in property <[bool]> changed-files-staged: [];
    in property <[bool]> changed-files-unstaged: [];
    in property <[string]> history-commits: [];
    in property <[string]> history-details: [];
    in property <[string]> diff-lines: [];
    in property <[int]> diff-line-types: [];
    in property <[string]> branch-names: [];
    in property <string> current-branch-name: "";
    in property <[bool]> branch-current: [];

    in property <int> staged-file-count: 0;
    in property <int> history-count: 0;
    in property <[int]> history-lanes: [];
    in property <[bool]> history-is-active: [];
    in property <[bool]> history-has-upper-line: [];
    in property <[bool]> history-is-upper-line-active: [];
    in property <[[int]]> history-parent-lanes: [];
    in property <[[bool]]> history-parent-lanes-active: [];
    in property <[[int]]> history-active-lanes: [];
    in property <[[bool]]> history-active-lanes-active: [];
    in property <int> history-max-lane: 0;

    in property <bool> operation-visible: false;
    in property <string> operation-title: "";
    in property <string> operation-command: "";
    in property <[string]> operation-log-lines: [];
    in property <string> operation-status: "Running...";
    in property <bool> operation-running: false;

    in property <bool> clone-dialog-visible: false;
    in-out property <string> clone-dialog-url: "";
    in-out property <string> clone-dialog-destination: "";

    callback close-operation-dialog();

    callback open-repository();
    callback select-repository(int);
    callback remove-repository(int);
    callback stage-file(int);
    callback unstage-file(int);
    callback commit(string);
    callback select-file(int);
    callback checkout-branch(int);
    callback checkout-branch-name(string);
    callback fetch();
    callback pull();
    callback push();
    callback clone-dialog-cancel();
    callback clone-dialog-clone(string, string);
    callback clone-dialog-browse();
    callback clone();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        HorizontalLayout {
            padding: 12px;
            alignment: start;
            spacing: 140px;

            Text {
                text: "GitFreak";
                font-size: 22px;
                font-weight: 800;
                color: #1e293b;
                vertical-alignment: center;
            }

            HorizontalLayout {
                alignment: start;
                spacing: 5px;
                padding-top: 2px;

                Rectangle {
                    width: 140px;
                    height: 32px;
                    background: #2563eb;
                    border-radius: 4px;
                    TouchArea {
                        clicked => {
                            root.open-repository();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "📁 Open Repository";
                            font-size: 13px;
                            font-weight: 600;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 60px;
                    height: 32px;
                    background: #ffffff;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    TouchArea {
                        clicked => {
                            root.fetch();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Fetch";
                            font-size: 13px;
                            color: #334155;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 60px;
                    height: 32px;
                    background: #ffffff;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    TouchArea {
                        clicked => {
                            root.pull();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Pull";
                            font-size: 13px;
                            color: #334155;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 60px;
                    height: 32px;
                    background: #ffffff;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    TouchArea {
                        clicked => {
                            root.push();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Push";
                            font-size: 13px;
                            color: #334155;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 60px;
                    height: 32px;
                    background: #ffffff;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    TouchArea {
                        clicked => {
                            root.clone();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Clone";
                            font-size: 13px;
                            color: #334155;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // 1. LEFTMOST PANEL: REPOSITORIES
            Rectangle {
                width: 250px;
                background: #f8fafc;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Repositories";
                        font-size: 16px;
                        font-weight: 700;
                        color: #1e293b;
                    }

                    ListView {
                        vertical-stretch: 1;

                        for repository[index] in root.repository-names: Rectangle {
                            height: 32px;
                            background: transparent;

                            HorizontalLayout {
                                spacing: 4px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;

                                        clicked => {
                                            root.select-repository(index);
                                        }
                                    }

                                    Text {
                                        text: repository;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                Button {
                                    text: "×";
                                    width: 32px;

                                    clicked => {
                                        root.remove-repository(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // RIGHT CONTENT AREA
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 12px;

                Text {
                    text: "Repository: " + root.repository-path;
                    font-size: 12px;
                    color: #64748b;
                }

                // UPPER WORKSPACE (Branches + Changes + Diff)
                HorizontalLayout {
                    height: 400px;
                    spacing: 12px;

                    // MIDDLE COLUMN (Branch Dropdown Header + Changes Container)
                    VerticalLayout {
                        width: 420px;
                        spacing: 12px;

                        // BRANCHES CARD (Dropdown only header)
                        Rectangle {
                            height: 50px;
                            background: #ffffff;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            HorizontalLayout {
                                padding: 8px;
                                spacing: 12px;

                                Text {
                                    text: "Branches";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: #1e293b;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                ComboBox {
                                    width: 180px;
                                    model: root.branch-names;
                                    current-value: root.current-branch-name;
                                    enabled: root.branch-names.length > 0;

                                    selected(branch) => {
                                        if (branch != root.current-branch-name) {
                                            root.checkout-branch-name(branch);
                                        }
                                    }
                                }
                            }
                        }

                        // Changes Container
                        Rectangle {
                            vertical-stretch: 1;
                            background: #ffffff;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 8px;

                                Text {
                                    text: "Changes";
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: #1e293b;
                                }

                                Text {
                                    text: root.status-text;
                                    color: #808080;
                                }

                                // 3. Scrollable Changes ListView
                        ListView {
                                    vertical-stretch: 1;

                                    for file[index] in root.changed-files: Rectangle {
                                        height: 36px;

                                        TouchArea {
                                            x: 0px;
                                            width: parent.width - 40px;
                                            height: parent.height;

                                            clicked => {
                                                root.select-file(index);
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            padding: 4px;

                                            CheckBox {
                                                checked: root.changed-files-staged[index];
                                                toggled => {
                                                    if (self.checked) {
                                                        root.stage-file(index);
                                                    } else {
                                                        root.unstage-file(index);
                                                    }
                                                }
                                            }

                                            Text {
                                                text: file;
                                                font-size: 14px;
                                                color: #252525;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 52px;
                                    background: #ffffff;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #d0d0d0;

                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;

                                        commit_message := LineEdit {
                                            placeholder-text: "Commit message...";
                                            horizontal-stretch: 1;
                                        }

                                        Button {
                                            text: "Commit";

                                            enabled: root.staged-file-count > 0 &&
                                                commit_message.text != "";

                                            clicked => {
                                                root.commit(commit_message.text);
                                                commit_message.text = "";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // RIGHT: Diff
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #ffffff;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "Diff";
                                font-size: 18px;
                                font-weight: 700;
                                color: #1e293b;
                            }

                            ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    alignment: start;

                                    for line[index] in root.diff-lines: Rectangle {
                                        height: 20px;

                                        background: {
                                            if (root.diff-line-types[index] == 1) {
                                                return #e8f5e9;
                                            }
                                            if (root.diff-line-types[index] == 2) {
                                                return #ffebee;
                                            }
                                            if (root.diff-line-types[index] == 3) {
                                                return #f5f5f5;
                                            }
                                            if (root.diff-line-types[index] == 4) {
                                                return #e3f2fd;
                                            }
                                            return transparent;
                                        }

                                        Text {
                                            text: line;
                                            x: 8px;
                                            y: 0px;
                                            width: parent.width - 16px;
                                            height: parent.height;

                                            font-size: 13px;
                                            font-family: "Consolas";

                                            color: {
                                                if (root.diff-line-types[index] == 1) {
                                                    return #2e7d32;
                                                }
                                                if (root.diff-line-types[index] == 2) {
                                                    return #c62828;
                                                }
                                                if (root.diff-line-types[index] == 4) {
                                                    return #1565c0;
                                                }
                                                return #252525;
                                            }

                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    background: #ffffff;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: "History";
                            font-size: 18px;
                            font-weight: 700;
                            color: #1e293b;
                        }

                        ListView {
                            vertical-stretch: 1;

                            for commit[index] in root.history-commits: Rectangle {
                                height: 42px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    CommitGraphRow {
                                        height: parent.height;

                                        lane: root.history-lanes[index];

                                        is-active: root.history-is-active[index];

                                        has-upper-line: root.history-has-upper-line[index];

                                        is-upper-line-active: root.history-is-upper-line-active[index];

                                        parent-lanes: root.history-parent-lanes[index];

                                        parent-lanes-active: root.history-parent-lanes-active[index];

                                        active-lanes: root.history-active-lanes[index];

                                        active-lanes-active: root.history-active-lanes-active[index];

                                        max-lane: root.history-max-lane;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;

                                        Text {
                                            text: commit;
                                            font-size: 14px;

                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: root.history-details[index];

                                            font-size: 12px;
                                            color: #808080;

                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // FULL-WIDTH FOOTER BAR
        HorizontalLayout {
            padding: 8px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;

            Text {
                text: "Files: " + root.changed-files.length;
                color: #808080;
                font-size: 12px;
            }

            Rectangle {
                background: transparent;
            }

            Text {
                text: "GitFreak";
                color: #808080;
                font-size: 12px;
            }
        }
    }

    OperationDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        dialog-visible: root.operation-visible;
        operation-title: root.operation-title;
        operation-command: root.operation-command;
        operation-log-lines: root.operation-log-lines;
        operation-status: root.operation-status;
        operation-running: root.operation-running;

        close-dialog => {
            root.close-operation-dialog();
        }
    }

    if root.clone-dialog-visible: Rectangle {
        background: #00000040;

        CloneDialog {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            repository-url <=> root.clone-dialog-url;
            destination <=> root.clone-dialog-destination;

            cancel => {
                root.clone-dialog-cancel();
            }

            clone(url, destination) => {
                root.clone-dialog-clone(
                    url,
                    destination);
            }

            browse-destination => {
                root.clone-dialog-browse();
            }
        }
    }
}
