import { Button, LineEdit, ListView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "GitFreak";

    width: 1000px;
    height: 700px;

    in property <string> repository-path: "";
    in property <string> status-text: "No repository opened.";
    in property <[string]> changed-files: [];
    in property <[bool]> changed-files-staged: [];
    in property <[bool]> changed-files-unstaged: [];
    in property <int> staged-file-count: 0;

    callback open-repository();
    callback stage-file(int);
    callback unstage-file(int);
    callback commit(string);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            alignment: start;
            spacing: 12px;

            Text {
                text: "GitFreak";
                font-size: 28px;
                vertical-alignment: center;
            }

            Button {
                text: "Open Repository";

                clicked => {
                    root.open-repository();
                }
            }
        }

        Text {
            text: root.repository-path;
            font-size: 13px;
            color: #808080;
        }

        Rectangle {
            height: 1px;
            background: #d0d0d0;
        }

        Text {
            text: "Changes";
            font-size: 20px;
        }

        Text {
            text: root.status-text;
            color: #808080;
        }

        Rectangle {
            height: 52px;
            background: #f5f5f5;
            border-radius: 4px;
            border-width: 1px;
            border-color: #d0d0d0;

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                
                commit_message := LineEdit {
                    placeholder-text: "Commit message...";
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Commit";

                    enabled: root.staged-file-count > 0 &&
                             commit_message.text != "";

                    clicked => {
                        root.commit(
                            commit_message.text);

                        commit_message.text = "";
                    }
                }
            }
        }

        Rectangle {
            background: #f5f5f5;
            border-radius: 4px;
            border-width: 1px;
            border-color: #d0d0d0;

            ListView {
                for file[index] in root.changed-files: Rectangle {
                    height: 36px;

                    HorizontalLayout {
                        spacing: 8px;
                        padding: 4px;

                        Text {
                            text: file;
                            font-size: 14px;
                            color: #252525;
                            vertical-alignment: center;
                            overflow: elide;

                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Stage";
                            width: 80px;

                            visible: !root.changed-files-staged[index] ||
                                     root.changed-files-unstaged[index];

                            clicked => {
                                root.stage-file(index);
                            }
                        }

                        Button {
                            text: "Unstage";
                            width: 80px;

                            visible: root.changed-files-staged[index];

                            clicked => {
                                root.unstage-file(index);
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            Text {
                text: "Files: " + root.changed-files.length;
                color: #808080;
            }

            Rectangle {
                background: transparent;
            }

            Text {
                text: "GitFreak";
                color: #808080;
            }
        }
    }
}