import { Button, LineEdit, ListView } from "std-widgets.slint";
import { OperationDialog } from "OperationDialog.slint";
import { CommitGraphRow } from "CommitGraphRow.slint";

export component MainWindow inherits Window {
    title: "GitFreak";

    width: 1200px;
    height: 850px;

    in property <string> repository-path: "";
    in property <string> status-text: "No repository opened.";
    in property <string> diff-text: "Select a file to view its diff.";
    in property <[string]> changed-files: [];
    in property <[bool]> changed-files-staged: [];
    in property <[bool]> changed-files-unstaged: [];
    in property <[string]> history-commits: [];
    in property <[string]> history-details: [];
    in property <[string]> diff-lines: [];
    in property <[int]> diff-line-types: [];
    in property <[string]> branch-names: [];
    in property <[bool]> branch-current: [];

    in property <int> staged-file-count: 0;
    in property <int> history-count: 0;
    in property <[int]> history-lanes: [];
    in property <[int]> history-parent-lanes: [];
    in property <[int]> history-parent-lanes-1: [];
    in property <[int]> history-parent-counts: [];
    in property <[int]> history-active-lanes-0: [];
    in property <[int]> history-active-lanes-1: [];
    in property <[int]> history-active-lane-counts: [];

    in property <bool> operation-visible: false;
    in property <string> operation-title: "";
    in property <string> operation-command: "";
    in property <[string]> operation-log-lines: [];
    in property <string> operation-status: "Running...";
    in property <bool> operation-running: false;

    callback close-operation-dialog();

    callback open-repository();
    callback stage-file(int);
    callback unstage-file(int);
    callback commit(string);
    callback select-file(int);
    callback checkout-branch(int);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            alignment: start;
            spacing: 12px;

            Text {
                text: "GitFreak";
                font-size: 28px;
                vertical-alignment: center;
            }

            Button {
                text: "Open Repository";

                clicked => {
                    root.open-repository();
                }
            }
        }

        Text {
            text: root.repository-path;
            font-size: 13px;
            color: #808080;
        }

        Rectangle {
            height: 1px;
            background: #d0d0d0;
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;

                // Branches
                Rectangle {
                    height: 130px;

                    background: #f5f5f5;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #d0d0d0;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        Text {
                            text: "Branches";
                            font-size: 18px;
                        }

                        ListView {
                            vertical-stretch: 1;

                            for branch[index] in root.branch-names : Rectangle {
                                height: 28px;
                                width: parent.width;

                                TouchArea {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;

                                    clicked => {
                                        root.checkout-branch(index);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 6px;

                                    Text {
                                        text: root.branch-current[index]
                                            ? "●"
                                            : "○";

                                        width: 18px;

                                        color: root.branch-current[index]
                                            ? #2e7d32
                                            : #808080;

                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: branch != "" ? branch : "Unnamed Branch";

                                        horizontal-stretch: 1;

                                        font-size: 13px;
                                        color: #252525;

                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                // Changes Container
                Rectangle {
                    vertical-stretch: 1;
                    background: #f5f5f5;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #d0d0d0;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;

                        Text {
                            text: "Changes";
                            font-size: 20px;
                        }

                        Text {
                            text: root.status-text;
                            color: #808080;
                        }

                        // 3. Scrollable Changes ListView

                        ListView {
                            vertical-stretch: 1;

                            for file[index] in root.changed-files: Rectangle {
                                height: 36px;

                                TouchArea {
                                    x: 0px;
                                    width: 500px;
                                    height: parent.height;

                                    clicked => {
                                        root.select-file(index);
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding: 4px;

                                    Text {
                                        text: file;
                                        font-size: 14px;
                                        color: #252525;
                                        vertical-alignment: center;
                                        overflow: elide;

                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Stage";
                                        width: 80px;

                                        visible: !root.changed-files-staged[index] ||
                                                 root.changed-files-unstaged[index];

                                        clicked => {
                                            root.stage-file(index);
                                        }
                                    }

                                    Button {
                                        text: "Unstage";
                                        width: 80px;

                                        visible: root.changed-files-staged[index];

                                        clicked => {
                                            root.unstage-file(index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 52px;
                    background: #ffffff;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #d0d0d0;

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;

                        commit_message := LineEdit {
                            placeholder-text: "Commit message...";
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Commit";

                            enabled: root.staged-file-count > 0 &&
                                     commit_message.text != "";

                            clicked => {
                                root.commit(commit_message.text);
                                commit_message.text = "";
                            }
                        }
                    }
                }
            }

        // RIGHT: Diff
        Rectangle {
            horizontal-stretch: 2;
            background: #ffffff;
            border-radius: 4px;
            border-width: 1px;
            border-color: #d0d0d0;

            VerticalLayout {
                padding: 8px;
                    spacing: 8px;

                Text {
                    text: "Diff";
                    font-size: 20px;
                }

                Flickable {
                    vertical-stretch: 1;

                    content-width: self.width;
                    content-height: root.diff-lines.length * 20px;

                    VerticalLayout {
                        width: parent.width;

                        for line[index] in root.diff-lines : Rectangle {
                            height: 20px;

                            background: {
                                if (root.diff-line-types[index] == 1) {
                                    return #e8f5e9;
                                }

                                if (root.diff-line-types[index] == 2) {
                                    return #ffebee;
                                }

                                if (root.diff-line-types[index] == 3) {
                                    return #f5f5f5;
                                }

                                if (root.diff-line-types[index] == 4) {
                                    return #e3f2fd;
                                }

                                return transparent;
                            }

                            Text {
                                text: line;
                                x: 8px;
                                y: 0px;
                                width: parent.width - 16px;
                                height: parent.height;

                                font-size: 13px;
                                font-family: "Consolas";

                                color: {
                                    if (root.diff-line-types[index] == 1) {
                                        return #2e7d32;
                                    }

                                    if (root.diff-line-types[index] == 2) {
                                        return #c62828;
                                    }

                                    if (root.diff-line-types[index] == 4) {
                                        return #1565c0;
                                    }

                                    return #252525;
                                }

                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }

        Rectangle {
            height: 220px;

            background: #f5f5f5;
            border-radius: 4px;
            border-width: 1px;
            border-color: #d0d0d0;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: "History";
                    font-size: 20px;
                }

                ListView {
                    vertical-stretch: 1;

                    for commit[index] in root.history-commits : Rectangle {
                        height: 42px;

                        HorizontalLayout {
                            spacing: 8px;

                            CommitGraphRow {
                                width: 120px;
                                height: parent.height;

                                lane:
                                    root.history-lanes[index];

                                parent-lane-0:
                                    root.history-parent-lanes[index];

                                parent-lane-1:
                                    root.history-parent-lanes-1[index];

                                parent-count:
                                    root.history-parent-counts[index];

                                active-lane-0:
                                    root.history-active-lanes-0[index];

                                active-lane-1:
                                    root.history-active-lanes-1[index];

                                active-lane-count:
                                    root.history-active-lane-counts[index];
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;

                                Text {
                                    text: commit;
                                    font-size: 14px;

                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    text:
                                        root.history-details[index];

                                    font-size: 12px;
                                    color: #808080;

                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            Text {
                text: "Files: " + root.changed-files.length;
                color: #808080;
            }

            Rectangle {
                background: transparent;
            }

            Text {
                text: "GitFreak";
                color: #808080;
            }
        }
    }

    OperationDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        dialog-visible: root.operation-visible;
        operation-title: root.operation-title;
        operation-command: root.operation-command;
        operation-log-lines: root.operation-log-lines;
        operation-status: root.operation-status;
        operation-running: root.operation-running;

        close-dialog => {
            root.close-operation-dialog();
        }
    }
}